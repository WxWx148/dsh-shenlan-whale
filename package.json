{
  "name": "dsh-shenlan-whale",
  "version": "0.46.6",
  "description": "深蓝鲸 —— 长在本地的人格体，通道可换，记忆不丢",
  "type": "module",
  "main": "index.js",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "qq",
    "onebot",
    "napcat",
    "chatbot",
    "persona"
  ],
  "scripts": {
    "test": "node tests/all.mjs",
    "check": "node scripts/check-identity.mjs && node scripts/check-copy.mjs && node scripts/check-layers.mjs && node scripts/check-ui.mjs",
    "probe": "node probes/all.mjs",
    "audit:config": "node scripts/check-config-consumers.mjs",
    "audit:dead": "node scripts/check-dead-code.mjs",
    "bench": "node scripts/bench-panel.mjs",
    "bench:prompt": "node scripts/bench-prompt.mjs",
    "taxonomy": "node scripts/dump-taxonomy.mjs",
    "test:host": "node tests/host.test.mjs",
    "test:memory": "node tests/whale-memory.test.mjs",
    "structure": "node scripts/gen-structure.mjs",
    "structure:check": "node scripts/gen-structure.mjs --check",
    "sync": "node scripts/sync-to-profile.mjs",
    "check:sync": "node scripts/sync-to-profile.mjs --check",
    "smoke": "node scripts/smoke-chain.mjs",
    "reconcile": "node scripts/reconcile.mjs",
    "verify:copy": "node scripts/verify-copy-load.mjs",
    "verify:http": "node scripts/verify-http.mjs",
    "audit": "node scripts/audit-all.mjs",
    "manifest:dump": "node scripts/dump-manifest.mjs",
    "manifest:check": "node scripts/dump-manifest.mjs --check"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "lib",
    "base",
    "channel",
    "voice",
    "facts",
    "truth",
    "decide",
    "turn",
    "mind",
    "ability",
    "life",
    "view",
    "app",
    "cordis.patch.yml",
    "package.json",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.panel.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "author": {
    "name": "深蓝鲸项目"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WxWx148/dsh-shenlan-whale.git"
  },
  "homepage": "https://github.com/WxWx148/dsh-shenlan-whale#readme",
  "bugs": {
    "url": "https://github.com/WxWx148/dsh-shenlan-whale/issues"
  }
}
